{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "cc9/fluxkit",
    "description": "Blade components layered on top of Flux and Livewire (<x-fluxkit::card> and more)",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/Nakanokappei/fluxkit",
    "require": {
        "php": "^8.4",
        "illuminate/support": "^13.0",
        "illuminate/view": "^13.0",
        "livewire/flux": "^2.13",
        "livewire/livewire": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "Cc9\\Fluxkit\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cc9\\Fluxkit\\FluxkitServiceProvider"
            ]
        }
    }
}
